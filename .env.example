# Runtime mode: dev, test, or prod.
ATLAS20_ENV=dev

# CORS origins as a JSON array.
ATLAS20_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database URL reserved for persistence phases.
ATLAS20_DB_URL=sqlite:///./data/atlas20.sqlite

# Local development secret; replace outside dev.
ATLAS20_SECRET_KEY=dev-only-do-not-use-in-prod

# API keys as a JSON array; wired in a later security phase.
ATLAS20_API_KEYS=[]

# Optional Sentry DSN for production error capture.
ATLAS20_SENTRY_DSN=

# Enable FastAPI docs, redoc, and OpenAPI schema.
ATLAS20_ENABLE_DOCS=true

# Root for report artifacts.
ATLAS20_REPORT_ROOT=reports

# Root for local data files.
ATLAS20_DATA_ROOT=data

# Set to 1 to disable the scheduler loop in containers or test harnesses.
ATLAS20_DISABLE_SCHEDULER=0

# Optional UTC date override for deterministic tests.
# ATLAS20_ANCHOR_DATE=2026-05-19

# Root logging level: DEBUG, INFO, WARNING, or ERROR.
ATLAS20_LOG_LEVEL=INFO

# Optional file path for structured log rotation.
ATLAS20_LOG_FILE_PATH=

# Logging format: json or text.
ATLAS20_LOG_FORMAT=json
