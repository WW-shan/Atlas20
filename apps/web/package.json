{
  "name": "atlas20-web",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc -b",
    "lint": "eslint src --max-warnings=0",
    "openapi": "openapi-typescript src/lib/api-schema.json -o src/lib/api.generated.ts",
    "openapi:check": "openapi-typescript src/lib/api-schema.json -o src/lib/api.generated.ts && git diff --exit-code -- src/lib/api.generated.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.83.0",
    "echarts": "^5.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.11.4",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vitest": "^4.1.8",
    "vitest-axe": "^0.1.0"
  }
}
