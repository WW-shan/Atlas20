VITE_ATLAS20_API_BASE=/api

# Optional: set when backend has ATLAS20_API_KEYS configured.
VITE_ATLAS20_API_KEY=

# Optional local/test bearer token. Production OAuth integrations should call
# setApiBearerToken() after obtaining a runtime token instead of baking one into
# the bundle.
VITE_ATLAS20_BEARER_TOKEN=
