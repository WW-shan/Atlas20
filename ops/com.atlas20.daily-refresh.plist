<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.atlas20.daily-refresh</string>
	<!--
	  Refreshes the raw provider cache and rebuilds the processed panel.

	  Why a wrapper script instead of a single command: the download step only
	  updates data/raw, while every strategy reads data/processed/panel_daily.csv.
	  Running both under one lock keeps "new data arrived" and "the panel knows
	  about it" in the same job, so a silent half-refresh cannot leave research
	  running on a stale panel - and a slow run can never race a catch-up fire
	  into the same raw cache.

	  The schedule fires three times, and scripts/refresh_daily_data.py exits
	  immediately when the panel already carries the last completed UTC day, so
	  only the runs that are actually needed do any work:

	    10:30 Beijing (02:30 UTC)  primary run, after CMC finalises day D-1
	    10:55 Beijing (02:55 UTC)  pre-trade catch-up, 10 min before the
	                               11:05 derivatives job reads the panel
	    14:30 Beijing (06:30 UTC)  late catch-up for anything that still failed

	  The pre-trade catch-up is what makes a shutdown in the middle of the
	  primary run survivable: on 2026-10-16 the machine went down at 10:34 and
	  killed the primary mid-write, so the panel stayed on 10-14 and the 11:05
	  trade job failed closed.  With this fire the panel is repaired 10 minutes
	  before the trade, and the trade job can also repair it itself.

	  Both the download and the build write through temp files, and the lock is
	  released by the OS if the process is killed, so a reboot cannot leave a
	  stale lock behind.

	  launchd reads StartCalendarInterval in the machine's LOCAL time zone,
	  not UTC. This workstation runs Asia/Shanghai (UTC+8), so 02:30/02:55/
	  06:30 UTC are Hour 10:30, 10:55 and 14:30 below. On a machine in another
	  zone, convert again: Hour 2/6 here would fire at 18:30/22:30 UTC, before
	  the close exists. tests/test_launchd_refresh_schedule.py pins this.
	-->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-lc</string>
		<string>cd /Users/ww/Project/Atlas20 &amp;&amp; .venv/bin/python scripts/refresh_daily_data.py --config config/base.yaml</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/ww/Project/Atlas20</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>10</integer>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>10</integer>
			<key>Minute</key>
			<integer>55</integer>
		</dict>
		<dict>
			<key>Hour</key>
			<integer>14</integer>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/Users/ww/Library/Logs/atlas20-daily-refresh.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/ww/Library/Logs/atlas20-daily-refresh.log</string>
</dict>
</plist>
