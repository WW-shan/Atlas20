[Unit]
Description=Run and retry the Atlas20 derivatives rebalance inside the daily window

[Timer]
# 03:05 UTC (11:05 Beijing) is five minutes after the LS45 ledger's T+1 +3h
# execution hint. The later 03:35/04:35/06:35 UTC fires are fallbacks for a
# late provider, reboot, or transient API/order failure. A successful same-day
# run makes each retry a quick no-op through the state gate.
OnCalendar=*-*-* 03:05:00 UTC
OnCalendar=*-*-* 03:35:00 UTC
OnCalendar=*-*-* 04:35:00 UTC
OnCalendar=*-*-* 06:35:00 UTC
Persistent=true
AccuracySec=1min
Unit=atlas20-derivatives-execute.service

[Install]
WantedBy=timers.target
