[Unit]
Description=Run the Atlas20 derivatives rebalance once at the backtest clock

[Timer]
# 09:05 Beijing = 01:05 UTC.  One attempt only; failures are surfaced by the
# 19:00 monitor.  Persistent is intentionally false so a reboot cannot replay
# a stale trade hours later.
OnCalendar=*-*-* 01:05:00 UTC
Persistent=false
AccuracySec=1s
Unit=atlas20-derivatives-execute.service

[Install]
WantedBy=timers.target
