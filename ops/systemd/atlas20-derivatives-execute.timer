[Unit]
Description=Run and retry the Atlas20 derivatives rebalance inside the daily window

[Timer]
# 09:05 Beijing = 01:05 UTC: the early execution after the 10-asset CMC probe's
# 00:20 UTC publication window. The later 03:05/03:35/04:35/06:35 UTC fires are
# fallbacks for a late provider, reboot, or transient API/order failure. A
# successful same-day run makes each retry a quick no-op through the state gate.
OnCalendar=*-*-* 01:05:00 UTC
OnCalendar=*-*-* 01:35:00 UTC
OnCalendar=*-*-* 03:05:00 UTC
OnCalendar=*-*-* 03:35:00 UTC
OnCalendar=*-*-* 04:35:00 UTC
OnCalendar=*-*-* 06:35:00 UTC
Persistent=true
AccuracySec=1min
Unit=atlas20-derivatives-execute.service

[Install]
WantedBy=timers.target
