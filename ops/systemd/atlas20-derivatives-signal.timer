[Unit]
Description=Run the Atlas20 derivatives Telegram signal once per day

[Timer]
# 01:05 UTC (09:05 Beijing) is the automated executor's early fill window;
# 01:35 UTC catches a failed first run.
OnCalendar=*-*-* 01:05:00 UTC
OnCalendar=*-*-* 01:35:00 UTC
Persistent=true
AccuracySec=1min
Unit=atlas20-derivatives-signal.service

[Install]
WantedBy=timers.target
