[Unit]
Description=Run the Atlas20 derivatives Telegram signal once per day

[Timer]
# Run after the automated executor instead of racing its signal rebuild.
# These are fallback notification attempts if the executor's Telegram send failed.
OnCalendar=*-*-* 03:45:00 UTC
OnCalendar=*-*-* 04:15:00 UTC
Persistent=true
AccuracySec=1min
Unit=atlas20-derivatives-signal.service

[Install]
WantedBy=timers.target
