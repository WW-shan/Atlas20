[Unit]
Description=Run the Atlas20 daily data acquisition node

[Timer]
# 08:30 Beijing = 00:30 UTC.  One acquisition attempt before the 08:35 signal
# build.  There are no catch-up or fallback fires; failures are reported by the
# 19:00 monitor.
OnCalendar=*-*-* 00:30:00 UTC
Persistent=false
AccuracySec=1s
Unit=atlas20-data-refresh.service

[Install]
WantedBy=timers.target
