[Unit]
Description=Refresh Atlas20 LS104 marks/funding between live execution windows

[Timer]
# 08:35 / 08:55 / 13:05 / 15:05 / 21:05 / 03:05 Beijing =
# 00:35 / 00:55 / 05:05 / 07:05 / 13:05 / 19:05 UTC.  The 00:35 UTC fire is the
# normal pre-execution prepare; 00:55 is the catch-up and no-ops when the
# receipt is still valid.  These fires are separate from the 01:05 UTC trading
# chain and never call the executor.  The shared execution lock makes a fire
# skip if a run is active.  05:05 UTC refreshes the 04:00 settlement before
# the 06:35 UTC final retry makes it mandatory after the one-hour allowance.
OnCalendar=*-*-* 00:35:00 UTC
OnCalendar=*-*-* 00:55:00 UTC
OnCalendar=*-*-* 05:05:00 UTC
OnCalendar=*-*-* 07:05:00 UTC
OnCalendar=*-*-* 13:05:00 UTC
OnCalendar=*-*-* 19:05:00 UTC
Persistent=true
AccuracySec=1min
Unit=atlas20-derivatives-refresh.service

[Install]
WantedBy=timers.target
