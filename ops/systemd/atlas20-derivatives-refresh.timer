[Unit]
Description=Run the Atlas20 daily data and signal preparation node

[Timer]
# 08:35 Beijing = 00:35 UTC.  The strategy is daily-bar based; the 01:05
# execution clock is not a signal-build clock.  There is no prepare retry,
# catch-up, or 01:00 finalize.  A failure is surfaced by the 19:00 monitor.
OnCalendar=*-*-* 00:35:00 UTC
Persistent=false
AccuracySec=1s
Unit=atlas20-derivatives-refresh.service

[Install]
WantedBy=timers.target
