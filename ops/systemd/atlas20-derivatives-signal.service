[Unit]
Description=Atlas20 LS45-G125 daily Telegram signal
Documentation=file:/opt/atlas20/docs/operations/telegram_signal.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/atlas20
EnvironmentFile=-/etc/atlas20/telegram.env
ExecStart=/usr/bin/make derivatives-live-data derivatives-ls45-signal audit-data audit-data-chain derivatives-notify
