[Unit]
Description=Atlas20 LS104-G175-M090 daily Telegram signal (notification only)
Documentation=file:/opt/atlas20/docs/operations/telegram_signal.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/atlas20
EnvironmentFile=-/etc/atlas20/telegram.env
ExecStart=/usr/bin/make derivatives-live-data derivatives-ls104-signal audit-data-chain audit-data-ls104 audit-signal-ls104 derivatives-notify-ls104
