[Unit]
Description=Atlas20 daily data acquisition (CMC/Bitget; no trading)
Documentation=file:/opt/atlas20/docs/operations/derivatives_live_runbook.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/atlas20
EnvironmentFile=-/etc/atlas20/atlas20.env
Environment=ATLAS20_PROJECT_ROOT=/opt/atlas20
Environment=ATLAS20_CONFIG_DIR=/etc/atlas20
ExecStart=/bin/sh /opt/atlas20/ops/run_derivatives_data.sh
TimeoutStartSec=1800
