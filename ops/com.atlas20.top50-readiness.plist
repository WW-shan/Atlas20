<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.atlas20.top50-readiness</string>
	<!--
	  Fallback readiness refresh and Telegram delivery after the 09:05 Beijing
	  live fill.  The primary data build runs inside the 08:35/08:55 prepare
	  sequence under the shared execution lock.  This single 09:45 fire retries
	  pending notifications and repairs a missed readiness report without ever
	  placing an order or loading trading credentials.
	-->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>/Users/ww/Project/Atlas20/ops/run_top50_readiness.sh</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/ww/Project/Atlas20</string>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Hour</key>
			<integer>9</integer>
			<key>Minute</key>
			<integer>45</integer>
		</dict>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>ThrottleInterval</key>
	<integer>300</integer>
	<key>StandardOutPath</key>
	<string>/Users/ww/Library/Logs/atlas20-top50-readiness.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/ww/Library/Logs/atlas20-top50-readiness.log</string>
</dict>
</plist>
